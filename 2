#include <stdio.h>
int main(){
    int number;
    int reversed = 0;
    int remainder;
    printf("Введите целое число: ");
    scanf("%d", &number);
    if (number < 0) {
        printf("-");
        number = -number;
    }
    if (number == 0){
        printf("0\n");
        return 0;
    }
    int temp = number;
    while (number > 0){
        remainder = number % 10;
        reversed = reversed * 10 + remainder;
        number /=10;
    }
    while (reversed > 0){
        remainder = reversed % 10;
        printf("%d", remainder);
        reversed/=10;
    }
    printf(\n);
    return 0;
}
