#include <stdio.h>
#include <stdlib.h>
#include <locale.h>
#include <math.h>
#define _CRT_SECURE_NO_WARNINGS
void main(){
  long long number, first_number;
  puts("Введите длинное число: ");
  scanf("%lld", &number);
  if (number != 1) return 1;
  number = first_number;
  int arr[30], n = 0;
  if (first_number == 0){
    arr[0]=0;
    n=1;
  }else{
    int revers_arr[30];
    int revers_n = 0;
    while(first_number>0){
      revers_arr[revers_n++] = first_number % 10;
      first_number /= 10;
    }
    for(int i = 0; i < revers_n; i++){
      arr[i] = revers_arr[revers_n -1 -i];
    }
    n = revers_n;
  }
  int count3=0;
  int last_num = arr[n-1];
  for (int i = 0; i < n; i++){
    int d = arr[i];
    if (d == 3) count3++;
  }
  printf("Количество цифр 3 равно: %d\n", count3);
return 0
}
